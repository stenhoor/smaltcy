{
  "name": "@smaltworks/smaltcy",
  "version": "0.1.0",
  "description": "A graph database for the browser that speaks Cypher, written in TypeScript.",
  "keywords": [
    "graph",
    "database",
    "cypher",
    "opencypher",
    "browser",
    "webgpu",
    "embedded"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltcy.git"
  },
  "homepage": "https://stenhoor.github.io/smaltcy/",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "node scripts/build.mjs",
    "test:browser": "node test/browser/run.mjs",
    "test:browser:quick": "node test/browser/run.mjs --quick",
    "test:quick": "npm run check && npm run test:browser:quick",
    "bench": "node scripts/bench.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/smaltcy.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "default": "./dist/engine.js"
    },
    "./plan": {
      "types": "./dist/types/plan/index.d.ts",
      "default": "./dist/plan.js"
    },
    "./functions": {
      "types": "./dist/types/functions/index.d.ts",
      "default": "./dist/functions.js"
    },
    "./store": {
      "types": "./dist/types/store/index.d.ts",
      "default": "./dist/store.js"
    },
    "./history": {
      "types": "./dist/types/history/index.d.ts",
      "default": "./dist/history.js"
    },
    "./cypher": {
      "types": "./dist/types/cypher/index.d.ts",
      "default": "./dist/cypher.js"
    },
    "./render": {
      "types": "./dist/types/render/index.d.ts",
      "default": "./dist/render.js"
    },
    "./timeline": {
      "types": "./dist/types/timeline/index.d.ts",
      "default": "./dist/timeline.js"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./datasets": {
      "types": "./dist/types/datasets/index.d.ts",
      "default": "./dist/datasets.js"
    },
    "./worker": "./dist/smaltcy-worker.js",
    "./worker-runtime": {
      "types": "./dist/types/worker/runtime.d.ts",
      "default": "./dist/worker-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "7.0",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "smaltkit": "github:stenhoor/smaltkit#e18b2ed526571657b3745884bb22cfe514eb6606"
  }
}
