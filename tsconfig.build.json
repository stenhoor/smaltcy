{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "paths": {}
  },
  "include": ["src"],
  // The compiler to smaltdb plans is not an entry point yet, and its types come from smaltdb (packed.json).
  "exclude": ["src/smaltdb"]
}
