{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@smaltworks/smaltcy": ["./src/index.ts"],
      "@smaltworks/smaltcy/engine": ["./src/engine/index.ts"],
      "@smaltworks/smaltcy/plan": ["./src/plan/index.ts"],
      "@smaltworks/smaltcy/cypher": ["./src/cypher/index.ts"],
      "@smaltworks/smaltcy/render": ["./src/render/index.ts"],
      "@smaltworks/smaltcy/datasets": ["./src/datasets/index.ts"],
      "@smaltworks/smaltcy/functions": ["./src/functions/index.ts"],
      "@smaltworks/smaltcy/store": ["./src/store/index.ts"],
      "@smaltworks/smaltcy/history": ["./src/history/index.ts"],
      "@smaltworks/smaltcy/timeline": ["./src/timeline/index.ts"],
      "@smaltworks/smaltcy/client": ["./src/client/index.ts"],
      "@smaltworks/smaltcy/worker-runtime": ["./src/worker/runtime.ts"]
    }
  },
  "include": ["src", "test", "bench", "scripts/*.ts"]
}
